if(NOT TIGERSHEETS_SOURCE_DIR)
  message(FATAL_ERROR "RELEASE BLOCKED: source directory is required")
endif()
find_program(TIGERSHEETS_GATE_PYTHON python3 REQUIRED)
set(gate_command "${TIGERSHEETS_GATE_PYTHON}" "${TIGERSHEETS_SOURCE_DIR}/tools/release_gate.py" --root "${TIGERSHEETS_SOURCE_DIR}")
if(TIGERSHEETS_RELEASE_REPORT)
  list(APPEND gate_command --report "${TIGERSHEETS_RELEASE_REPORT}")
endif()
execute_process(COMMAND ${gate_command} RESULT_VARIABLE gate_result OUTPUT_VARIABLE gate_output ERROR_VARIABLE gate_error)
message("${gate_output}")
if(NOT gate_result EQUAL 0)
  message(FATAL_ERROR "RELEASE BLOCKED: compatibility acceptance evidence is incomplete. ${gate_error}")
endif()
