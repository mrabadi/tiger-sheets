if(CPACK_TIGERSHEETS_CHANNEL STREQUAL "development")
  set(CPACK_PACKAGE_VERSION "${CPACK_PACKAGE_VERSION}~dev.4")
  set(CPACK_DEBIAN_PACKAGE_VERSION "${CPACK_PACKAGE_VERSION}")
  set(CPACK_PACKAGE_FILE_NAME "tiger-sheets_${CPACK_PACKAGE_VERSION}_amd64")
  set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "TigerSheets development build")
  set(CPACK_PACKAGE_DESCRIPTION "Local TigerSheets development build. Excel and VBA compatibility is incomplete; this package is for local evaluation.")
  set(CPACK_DEBIAN_PACKAGE_DESCRIPTION "${CPACK_PACKAGE_DESCRIPTION}")
  message(STATUS "Packaging TigerSheets development build ${CPACK_PACKAGE_VERSION}; full release acceptance is incomplete")
  return()
endif()
set(TIGERSHEETS_SOURCE_DIR "@TIGERSHEETS_SOURCE_DIR@")
set(TIGERSHEETS_RELEASE_REPORT "@TIGERSHEETS_RELEASE_REPORT@")
include("@TIGERSHEETS_SOURCE_DIR@/cmake/ReleasePackageGate.cmake")
