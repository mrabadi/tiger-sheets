# Complete releases require acceptance; local development installers are labeled.
set_target_properties(tiger-sheets PROPERTIES INSTALL_RPATH "$ORIGIN/../lib/tiger-sheets")
set_target_properties(tigersheets-report-worker PROPERTIES INSTALL_RPATH "$ORIGIN/../../lib/tiger-sheets")
install(TARGETS tiger-sheets RUNTIME DESTINATION bin)
install(TARGETS tigersheets-vba-worker RUNTIME DESTINATION libexec/tigersheets)
install(TARGETS tigersheets-report-worker RUNTIME DESTINATION libexec/tigersheets)
install(FILES ${TIGERSHEETS_SOLVER_RUNTIME_LIBRARIES} DESTINATION lib/tiger-sheets)
install(FILES packaging/tiger-sheets.desktop DESTINATION share/applications)
install(FILES packaging/tiger-sheets-mime.xml DESTINATION share/mime/packages)
install(DIRECTORY packaging/icons/hicolor DESTINATION share/icons)
install(DIRECTORY compatibility schemas DESTINATION share/tiger-sheets)
install(FILES third_party/ironcalc/LICENSE-MIT third_party/ironcalc/LICENSE-Apache-2.0 third_party/ironcalc/PINNED.md third_party/SOLVER_DEPS.json DESTINATION share/doc/tiger-sheets)
install(DIRECTORY "${TIGERSHEETS_SOLVER_PREFIX}/share/tiger-sheets/" DESTINATION share/tiger-sheets/dependencies OPTIONAL)
install(DIRECTORY third_party/licenses/ DESTINATION share/doc/tiger-sheets/licenses OPTIONAL)
install(DIRECTORY third_party/rust-vendor/ DESTINATION share/tiger-sheets/dependencies/rust-vendor)
install(FILES README.md DESTINATION share/doc/tiger-sheets)
install(DIRECTORY docs DESTINATION share/doc/tiger-sheets)
set(TIGERSHEETS_RELEASE_REPORT "${CMAKE_BINARY_DIR}/release-evidence.json" CACHE FILEPATH "Executed compatibility acceptance report")
set(TIGERSHEETS_SOURCE_DIR "${CMAKE_SOURCE_DIR}")
configure_file("${CMAKE_SOURCE_DIR}/cmake/CPackGate.cmake.in" "${CMAKE_BINARY_DIR}/CPackGate.cmake" @ONLY)
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_BINARY_DIR}/CPackGate.cmake")
set(CPACK_TIGERSHEETS_CHANNEL release)
configure_file("${CMAKE_SOURCE_DIR}/cmake/CPackDevelopmentConfig.cmake.in" "${CMAKE_BINARY_DIR}/CPackDevelopmentConfig.cmake" @ONLY)
set(CPACK_GENERATOR DEB)
set(CPACK_PACKAGE_NAME tiger-sheets)
set(CPACK_PACKAGE_VENDOR TigerSheets)
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Native local spreadsheet application")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "tiger-sheets_${PROJECT_VERSION}_amd64")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "TigerSheets contributors")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
# QPA plugins are loaded dynamically and are absent from ELF shlibdeps results.
set(CPACK_DEBIAN_PACKAGE_DEPENDS "qt6-qpa-plugins, qt6-wayland")
set(CPACK_DEBIAN_PACKAGE_SECTION math)
set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
include(CPack)
